listen-address: "0.0.0.0:19000"
state-path: /var/lib/sui-validator-signer/policy.journal
randomness-state-path: /var/lib/sui-validator-signer/randomness.bcs
protocol-key-path: /etc/sui-validator-signer/protocol.key
worker-key-path: /etc/sui-validator-signer/worker.key
chain-id: "<64 lowercase hex characters>"
max-lease-ttl-ms: 10000
max-payload-bytes: 4194304
lease-holder-certificate-digests:
  - "<validator-a client certificate BLAKE2b-256 DER digest>"
  - "<validator-b client certificate BLAKE2b-256 DER digest>"
status-reader-certificate-digests:
  - "<control service client certificate BLAKE2b-256 DER digest>"
tls:
  certificate-path: /etc/sui-validator-signer/tls/server.crt
  private-key-path: /etc/sui-validator-signer/tls/server.key
  client-ca-path: /etc/sui-validator-signer/tls/client-ca.crt
